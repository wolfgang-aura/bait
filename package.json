{
  "name": "nansen-bait",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BAIT: test how selective evidence persuades two AI desks, with real Nansen records and reproducible comparisons.",
  "scripts": {
    "start": "node prototype/server.js",
    "test": "node --test \"validation/**/*.test.js\" \"prototype/*.test.js\" \"bench/*.test.js\"",
    "bench": "node bench/run.js",
    "bench:paired": "node bench/paired.js",
    "bench:export": "node bench/export.js",
    "results:export": "node prototype/export-results.js",
    "demo:package": "node prototype/package-demo.js",
    "release:prepare": "node scripts/prepare-public-source.mjs",
    "quota": "node validation/quota.js",
    "quota:report": "node validation/analyze-robustness.js",
    "validate:smoke": "node validation/smoke.js",
    "validate:pitch": "node validation/verify_pitch.js pitch2.json"
  }
}
